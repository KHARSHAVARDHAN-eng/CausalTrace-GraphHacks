# ==============================================================================
# CausalTrace Backend Environment Configuration Template
# Duplicate this file to .env and configure for local deployment.
# NEVER COMMIT REAL SECRETS OR .env TO VERSION CONTROL.
# ==============================================================================

# Server configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FalkorDB Graph Database Configuration
# Default FalkorDB instance runs on redis protocol (port 6379)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=causaltrace

# AI / LLM Provider Configuration
# Supported providers: openai, anthropic, stub
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2
